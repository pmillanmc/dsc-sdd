# Permisos y preferencias de cada máquina, no del modelo.
.claude/settings.local.json

# Trabajo de clientes. Nunca sale de la máquina donde se hizo el discovery:
# los borradores de ideas/ salen de minutas y mails de terceros.
proyectos/

# Registro de trabajo de clientes. El repo del modelo lleva la logica, no los
# proyectos de nadie: estos archivos se llenan solos con lo que hace cada PM y
# cualquier `git add -A` los commitea. Las plantillas .template.yaml si viajan.
registry/proyectos.yaml
registry/capabilities.yaml
registry/features.yaml
registry/ids.yaml

# Salida generada. Se rehace con /dsc-dashboard y lleva adentro los datos
# de todos los proyectos, que es justamente lo que no se publica.
dashboard/data.js
dashboard/index.html

# Registro de sesiones de esta máquina.
metrics/

# Preferencias del editor, por maquina.
.vscode/

# Documentos de trabajo. Se comparten aparte, no por el repo.
*.docx
~$*
